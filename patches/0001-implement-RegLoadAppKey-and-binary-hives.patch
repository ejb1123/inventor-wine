+static const void *regf_cell( const struct regf_image *image, unsigned int offset, size_t size )
+{
+    size_t pos = REGF_HBIN_OFFSET + (size_t)offset;
+    int cell_size;
+
+    if (pos > image->size || size > image->size - pos || size < sizeof(cell_size)) return NULL;
+    memcpy( &cell_size, image->data + pos, sizeof(cell_size) );
+    if (cell_size >= 0 || (size_t)-cell_size < size || (size_t)-cell_size > image->size - pos) return NULL;
+    return image->data + pos;
+}
+
+static int regf_name( const unsigned char *src, unsigned int size, int compressed,
+                      WCHAR **buffer, struct unicode_str *name )
+{
+    unsigned int i, chars = compressed ? size : size / sizeof(WCHAR);
+
+    if (!compressed && (size & 1)) return 0;
+    if (!(*buffer = mem_alloc( (chars ? chars : 1) * sizeof(WCHAR) ))) return 0;
+    if (compressed)
+        for (i = 0; i < chars; i++) (*buffer)[i] = src[i];
+    else
+        memcpy( *buffer, src, size );
+    name->str = *buffer;
+    name->len = chars * sizeof(WCHAR);
+    return 1;
+}
+
+static int load_regf_key( const struct regf_image *image, struct key *parent, unsigned int offset );
+
+static int load_regf_subkeys( const struct regf_image *image, struct key *parent, unsigned int offset )
+{
+    const struct regf_key_list *list = regf_cell( image, offset, sizeof(*list) );
+    const unsigned int *offsets;
+    unsigned int i, stride;
+
+    if (!list) return 0;
+    if (list->signature == 0x666c || list->signature == 0x686c) stride = 2; /* lf/lh */
+    else if (list->signature == 0x696c || list->signature == 0x6972) stride = 1; /* li/ri */
+    else return 0;
+    offsets = regf_cell( image, offset, sizeof(*list) + list->count * stride * sizeof(*offsets) );
+    if (!offsets) return 0;
+    offsets = (const unsigned int *)((const unsigned char *)offsets + sizeof(*list));
+    for (i = 0; i < list->count; i++)
+    {
+        if (list->signature == 0x6972)
+        {
+            if (!load_regf_subkeys( image, parent, offsets[i] )) return 0;
+        }
+        else if (!load_regf_key( image, parent, offsets[i * stride] )) return 0;
+    }
+    return 1;
+}
+
+static int load_regf_value( const struct regf_image *image, struct key *key, unsigned int offset )
+{
+    const struct regf_value_key *value = regf_cell( image, offset, sizeof(*value) );
+    const unsigned char *data = NULL;
+    struct unicode_str name;
+    unsigned int data_size;
+    WCHAR *name_buffer;
+
+    if (!value || value->signature != 0x6b76 ||
+        !regf_cell( image, offset, sizeof(*value) + value->name_size )) return 0;
+    if (!regf_name( (const unsigned char *)(value + 1), value->name_size,
+                    value->flags & REGF_VALUE_COMP_NAME, &name_buffer, &name )) return 0;
+    data_size = value->data_size & 0x7fffffff;
+    if (value->data_size & 0x80000000) data = (const unsigned char *)&value->data_offset;
+    else if (data_size)
+    {
+        const int *cell = regf_cell( image, value->data_offset, sizeof(int) + data_size );
+        if (!cell) { free( name_buffer ); return 0; }
+        data = (const unsigned char *)(cell + 1);
+    }
+    set_value( key, &name, value->type, data, data_size );
+    free( name_buffer );
+    return !get_error();
+}
+
+static int load_regf_key( const struct regf_image *image, struct key *parent, unsigned int offset )
+{
+    const struct regf_named_key *node = regf_cell( image, offset, sizeof(*node) );
+    const unsigned int *value_offsets;
+    struct unicode_str name;
+    struct key *key;
+    WCHAR *name_buffer;
+    unsigned int i;
+
+    if (!node || node->signature != 0x6b6e ||
+        !regf_cell( image, offset, sizeof(*node) + node->name_size )) return 0;
+    if (!regf_name( (const unsigned char *)(node + 1), node->name_size,
+                    node->flags & REGF_KEY_COMP_NAME, &name_buffer, &name )) return 0;
+    key = create_key( parent, &name, 0, KEY_WOW64_64KEY, OBJ_OPENIF | OBJ_CASE_INSENSITIVE, NULL );
+    free( name_buffer );
+    if (!key) return 0;
+
+    if (node->values)
+    {
+        const int *cell = regf_cell( image, node->values_offset,
+                                     sizeof(int) + node->values * sizeof(*value_offsets) );
+        if (!cell) { release_object( key ); return 0; }
+        value_offsets = (const unsigned int *)(cell + 1);
+        for (i = 0; i < node->values; i++)
+            if (!load_regf_value( image, key, value_offsets[i] )) { release_object( key ); return 0; }
+    }
+    if (node->subkeys && !load_regf_subkeys( image, key, node->subkeys_offset ))
+    {
+        release_object( key );
+        return 0;
+    }
+    release_object( key );
+    return 1;
+}
+
+static int load_regf( struct key *key, int fd )
+{
+    struct regf_image image;
+    struct regf_header *header;
+    struct regf_named_key *root;
+    struct stat st;
+    unsigned char *buffer;
+    ssize_t count;
+    size_t done = 0;
+    int ret = 0;
+
+    if (fstat( fd, &st ) == -1 || st.st_size < REGF_HBIN_OFFSET ||
+        !(buffer = mem_alloc( st.st_size ))) return 0;
+    while (done < st.st_size)
+    {
+        count = pread( fd, buffer + done, st.st_size - done, done );
+        if (count <= 0) goto done;
+        done += count;
+    }
+    image.data = buffer;
+    image.size = st.st_size;
+    header = (struct regf_header *)buffer;
+    if (memcmp( header->signature, "regf", 4 )) goto done;
+    root = (struct regf_named_key *)regf_cell( &image, header->root_offset, sizeof(*root) );
+    if (!root || root->signature != 0x6b6e) goto done;
+    if (root->values)
+    {
+        const unsigned int *offsets;
+        const int *cell = regf_cell( &image, root->values_offset,
+                                     sizeof(int) + root->values * sizeof(*offsets) );
+        unsigned int i;
+        if (!cell) goto done;
+        offsets = (const unsigned int *)(cell + 1);
+        for (i = 0; i < root->values; i++) if (!load_regf_value( &image, key, offsets[i] )) goto done;
+    }
+    ret = !root->subkeys || load_regf_subkeys( &image, key, root->subkeys_offset );
+done:
+    free( buffer );
+    return ret;
+}
