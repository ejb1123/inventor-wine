+/* Compatibility reporting only: moving the service manager to a real separate
+ * session would also require converting Wine's service startup rendezvous.
+ * Go and .NET service detection expect services.exe to report session zero. */
+static unsigned int get_reported_session_id( struct process *process )
+{
+    static const WCHAR path[] = {'C',':','\\','w','i','n','d','o','w','s','\\',
+        's','y','s','t','e','m','3','2','\\','s','e','r','v','i','c','e','s','.','e','x','e'};
+    const char *enabled = getenv( "WINE_SERVICE_SESSION_ZERO" );
+
+    if (enabled && !strcmp( enabled, "1" ) && process->imagelen >= sizeof(path)
+        && !memicmp_strW( process->image + (process->imagelen - sizeof(path)) / sizeof(WCHAR),
+                         path, sizeof(path) ))
+        return 0;
+    return process->session_id;
+}
